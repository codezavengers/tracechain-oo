# TRACECHAIN environment variables.
#
# Copy this file to .env.local and fill in only the values you have. Every
# variable below is OPTIONAL — with none set, TRACECHAIN runs entirely on
# deterministic DEMO DATA (clearly labeled as such in the UI/API) so the app
# is always usable offline. Set a variable to unlock real LIVE/INDEXED
# blockchain data for that chain. Never commit a filled-in .env.local.

# ---------------------------------------------------------------------------
# EVM chains — Ethereum, Polygon, BSC
# ---------------------------------------------------------------------------
# A single Etherscan V2 unified-API key enables all three EVM chains via the
# `chainid` parameter. Get a free key at https://etherscan.io/apis.
ETHERSCAN_API_KEY=

# Optional per-chain overrides if you use a dedicated explorer endpoint/key
# instead of the unified Etherscan V2 API for a specific chain. Any chain
# left blank falls back to ETHERSCAN_API_KEY / the Etherscan V2 base URL.
TRACECHAIN_ETH_API_URL=
TRACECHAIN_ETH_API_KEY=
TRACECHAIN_POLYGON_API_URL=
TRACECHAIN_POLYGON_API_KEY=
TRACECHAIN_BSC_API_URL=
TRACECHAIN_BSC_API_KEY=

# ---------------------------------------------------------------------------
# Bitcoin
# ---------------------------------------------------------------------------
# Bitcoin is LIVE by default — Blockstream's public Esplora API
# (https://blockstream.info/api) requires no key. Override only if you run
# your own Esplora-compatible endpoint (e.g. a self-hosted mempool.space).
TRACECHAIN_BTC_API_URL=
TRACECHAIN_BTC_API_KEY=

# ---------------------------------------------------------------------------
# TRON
# ---------------------------------------------------------------------------
# TronGrid (https://www.trongrid.io) is a public indexer, but its keyless
# rate limit is too low for reliable investigation traffic — an API key is
# required for TRON to be LIVE-capable. Without it, TRON falls back to DEMO.
TRACECHAIN_TRON_API_URL=
TRACECHAIN_TRON_API_KEY=

# ---------------------------------------------------------------------------
# Historical / spot USD price enrichment (optional, all chains)
# ---------------------------------------------------------------------------
# When set, transaction and balance USD values are enriched from CoinGecko.
# When unset, every usdValue/usdBalance is null (never a fabricated 0) and
# tracing still succeeds — price enrichment never blocks a trace.
TRACECHAIN_PRICE_API_URL=https://api.coingecko.com/api/v3
TRACECHAIN_PRICE_API_KEY=

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Signing secret for session JWTs. Falls back to an insecure demo secret if
# unset — set a strong random value (e.g. `openssl rand -base64 32`) before
# any non-local deployment.
TRACECHAIN_JWT_SECRET=
